{% import 'partials/_macros.html.twig' as ui %}
<aside class="sidebar">
    <a class="logo" href="{{ path('app_home') }}" aria-label="Accueil RyoPets">
        {% include 'partials/_logo.svg.twig' %}
        <span class="logo__nom">Ryo<b>Pets</b></span>
    </a>

    <nav class="menu">
        <a href="{{ path('app_catalogue') }}">Produits</a>
        <a href="{{ path('app_animaux') }}">Animaux</a>
        {% for categorie in nav_categories() %}
            <a href="{{ path('app_catalogue', {categorie: categorie.id}) }}">{{ categorie.nom }}</a>
        {% endfor %}
        <a href="{{ path('app_panier') }}">Panier</a>
        {% if app.user %}
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
        {% endif %}
    </nav>

    {% set vedette = animal_vedette() %}
    {% if vedette %}
        <a class="sidebar__vedette" href="{{ path('app_animal_show', {id: vedette.id}) }}">
            {{ ui.visuel(vedette.photo, vedette.nom) }}
            <span>{{ vedette.nom }}<br><small>À adopter</small></span>
        </a>
    {% endif %}
</aside>
