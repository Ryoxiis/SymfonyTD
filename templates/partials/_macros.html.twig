{# Affiche la photo d'un produit ou d'un animal, ou un visuel par défaut.
   photo peut être une adresse complète (photo Unsplash) ou un nom de fichier rangé dans public/images/catalogue/. #}
{% macro visuel(photo, alt, classe = '') %}
    {% if photo %}
        <img class="visuel {{ classe }}" src="{{ photo starts with 'http' ? photo : asset('images/catalogue/' ~ photo) }}" alt="{{ alt }}" loading="lazy">
    {% else %}
        <span class="visuel visuel--vide {{ classe }}" role="img" aria-label="{{ alt }}">🐾</span>
    {% endif %}
{% endmacro %}

{% macro prix(montant) %}{{ montant|number_format(2, ',', ' ') }} €{% endmacro %}

{# Petit badge d'état : stock faible, rupture, animal déjà adopté #}
{% macro badge(item, type) %}
    {% if type == 'animal' %}
        {% if not item.disponible %}<span class="badge badge--sombre">Adopté</span>{% endif %}
    {% elseif item.stock < 1 %}
        <span class="badge badge--sombre">Rupture</span>
    {% elseif item.stock < 5 %}
        <span class="badge">Dernières pièces</span>
    {% endif %}
{% endmacro %}

{# Carte utilisée dans la galerie et les grilles du catalogue.
   L'image et « Agrandir » ouvrent la fiche dans la fenêtre modale ; le nom et « Détails » ouvrent la page complète. #}
{% macro carte(item, type) %}
    {% set route = type == 'animal' ? 'app_animal_show' : 'app_produit_show' %}
    <article class="carte apparition">
        <a class="carte__image" href="{{ path(route, {id: item.id}) }}" data-turbo-frame="modale">
            {{ _self.badge(item, type) }}
            {{ _self.visuel(item.photo, item.nom) }}
        </a>
        <div class="carte__texte">
            <h3><a href="{{ path(route, {id: item.id}) }}">{{ item.nom }}</a></h3>
            <p class="carte__meta">
                {% if type == 'animal' %}
                    {{ item.espece.nom }}{% if item.race %} · {{ item.race }}{% endif %}
                {% else %}
                    {{ item.categorie.nom }}
                {% endif %}
                · <strong class="prix-or">{{ _self.prix(item.prix) }}</strong>
            </p>
            <p class="carte__liens">
                <a href="{{ path(route, {id: item.id}) }}" data-turbo-frame="modale">Agrandir</a> · <a href="{{ path(route, {id: item.id}) }}">Détails</a>
            </p>
        </div>
    </article>
{% endmacro %}
