{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <form class="carte-form" method="post" action="{{ path('app_login') }}">
        <h1>Connexion</h1>

        {% if erreur %}
            <p class="erreur">{{ erreur.messageKey|trans(erreur.messageData, 'security') }}</p>
        {% endif %}

        <label for="email">Adresse email</label>
        <input type="email" id="email" name="_username" value="{{ dernier_email }}" autocomplete="email" required autofocus>

        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <button class="bouton" type="submit">Se connecter</button>

        <p class="aide">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a><br>
        Vous restez connecté : votre panier est conservé même si vous quittez le site.</p>
    </form>
{% endblock %}
