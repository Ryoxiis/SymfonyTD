<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}RyoPets{% endblock %} · Animalerie premium</title>
        <link rel="icon" href="data:image/svg+xml,<svg viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg'> <circle cx='32' cy='32' r='29.5' fill='none' stroke='%23c9a54a' stroke-width='1.6'/> <circle cx='32' cy='32' r='25.5' fill='none' stroke='%23c9a54a' stroke-width='.6' opacity='.55'/> <g fill='%23c9a54a'> <ellipse cx='19.5' cy='30' rx='3.6' ry='5' transform='rotate%28-22 19.5 30%29'/> <ellipse cx='26.8' cy='21.5' rx='3.6' ry='5.2' transform='rotate%28-8 26.8 21.5%29'/> <ellipse cx='37.2' cy='21.5' rx='3.6' ry='5.2' transform='rotate%288 37.2 21.5%29'/> <ellipse cx='44.5' cy='30' rx='3.6' ry='5' transform='rotate%2822 44.5 30%29'/> <path d='M32 33.5c-6.6 0-11.8 6-11.8 10.6 0 3.4 2.6 5.4 6 5.4 2.6 0 3.8-1.1 5.8-1.1s3.2 1.1 5.8 1.1c3.4 0 6-2 6-5.4 0-4.6-5.2-10.6-11.8-10.6z'/> </g> </svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="preconnect" href="https://images.unsplash.com">
        <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body data-controller="apparition panier">
        <div class="page">
            {% include 'partials/_sidebar.html.twig' %}

            <div class="contenu">
                {% include 'partials/_topbar.html.twig' %}

                {% for type, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="flash flash--{{ type }}">{{ message }}</div>
                    {% endfor %}
                {% endfor %}

                <main>
                    {% block body %}{% endblock %}
                </main>
            </div>

            {% include 'partials/_footer.html.twig' %}
        </div>

        {# Fenêtre modale des fiches (remplie par les liens « Agrandir ») #}
        <div class="modale" data-controller="modale"
             data-action="turbo:frame-load->modale#ouvrir keydown.esc@window->modale#fermer">
            <div class="modale__fond" data-action="click->modale#fermer"></div>
            <div class="modale__boite">
                <turbo-frame id="modale" data-modale-target="frame"></turbo-frame>
            </div>
        </div>

        {# Tiroir affiché après un ajout au panier #}
        <aside class="tiroir" data-panier-target="tiroir" aria-live="polite">
            <button type="button" class="tiroir__fermer" data-action="panier#fermer" aria-label="Fermer">✕</button>
            <p class="tiroir__titre" data-panier-target="titre"></p>
            <div class="tiroir__article" data-panier-target="article">
                <img data-panier-target="image" src="data:," alt="">
                <div>
                    <strong data-panier-target="nom"></strong>
                    <span data-panier-target="detail"></span>
                </div>
            </div>
            <div class="tiroir__actions">
                <a class="bouton bouton--petit" href="{{ path('app_panier') }}">Voir le panier</a>
                <button type="button" class="bouton bouton--petit bouton--sombre" data-action="panier#fermer">Continuer</button>
            </div>
        </aside>
    </body>
</html>
